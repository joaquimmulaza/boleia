# Copia este ficheiro para .env.local e preenche os valores reais.
# NUNCA subas o ficheiro .env.local para o GitHub!
#
# Como obter as credenciais:
#   1. Acede a https://supabase.com e abre o teu projeto
#   2. Vai em Project Settings > API
#   3. Copia a "Project URL" e a "anon public" key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL pública canónica (emails Supabase Auth — recovery, confirmação)
VITE_APP_URL=https://boleia-cyan.vercel.app

# Sentry DSN (Plano Gratuito)
# Como obter:
#   1. Cria conta/Acede a https://sentry.io/
#   2. Vai a Settings > Projects > [O Teu Projeto] > Client Keys (DSN)
#   3. Copia o valor do DSN
VITE_SENTRY_DSN=your-sentry-dsn-here
VITE_VAPID_PUBLIC_KEY=your-VITE_VAPID_PUBLIC_KEY-here

# IBAN da plataforma para transferências manuais (MVP pagamento — PACOTE ENG #5)
VITE_PLATFORM_IBAN=AO06004000000000000000000

# Graphify / Graphlore — extração semântica de docs (.specs/, AGENTS.md, etc.)
# Definir como secret no Cursor Cloud (GOOGLE_API_KEY). Nunca commitar valor real.
# Rate limits: https://ai.google.dev/gemini-api/docs/rate-limits
GOOGLE_API_KEY=

# OAuth social — NÃO prefixar com VITE_. Estes valores não entram no browser.
# Em produção configuram-se no Supabase Dashboard → Authentication → Providers.
# Em local, o CLI lê-os via supabase/config.toml (env(...)).
# A Apple private key (.p8), Team ID e Key ID ficam só no Dashboard; aqui vai o client secret já gerado.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=
