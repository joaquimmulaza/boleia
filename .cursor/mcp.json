{
  "mcpServers": {
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "graphlore": {
      "command": "graphlore",
      "env": {
        "GRAPHLORE_PROJECT_DIR": "${workspaceFolder}",
        "GRAPHLORE_OUT_DIR": "${workspaceFolder}/graphify-out",
        "GRAPHLORE_TOOLSET": "lean"
      }
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp"
    }
  }
}
