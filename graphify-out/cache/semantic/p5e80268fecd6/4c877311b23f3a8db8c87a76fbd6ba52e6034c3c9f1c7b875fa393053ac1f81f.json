{"nodes": [{"id": "javascript_express_web_server_security_express_input_001", "label": "EXPRESS-INPUT-001: Input Validation", "file_type": "rationale", "source_file": ".cline/skills/security-best-practices/references/javascript-express-web-server-security.md", "rationale": "Treat all user input as untrusted and validate it before using in security-sensitive logic or dangerous sinks."}, {"id": "javascript_express_web_server_security_express_redirect_001", "label": "EXPRESS-REDIRECT-001: Open Redirect Prevention", "file_type": "rationale", "source_file": ".cline/skills/security-best-practices/references/javascript-express-web-server-security.md", "rationale": "Validate redirect destinations derived from untrusted input to prevent open redirects."}, {"id": "javascript_express_web_server_security_express_headers_001", "label": "EXPRESS-HEADERS-001: Security Headers (Helmet)", "file_type": "rationale", "source_file": ".cline/skills/security-best-practices/references/javascript-express-web-server-security.md", "rationale": "Use Helmet to set essential security headers like CSP, X-Frame-Options, and X-Content-Type-Options."}, {"id": "javascript_express_web_server_security_express_cookie_001", "label": "EXPRESS-COOKIE-001: Secure Cookie Attributes", "file_type": "rationale", "source_file": ".cline/skills/security-best-practices/references/javascript-express-web-server-security.md", "rationale": "Cookies must use Secure, HttpOnly, and SameSite attributes appropriately."}, {"id": "javascript_express_web_server_security_express_csrf_001", "label": "EXPRESS-CSRF-001: CSRF Protection", "file_type": "rationale", "source_file": ".cline/skills/security-best-practices/references/javascript-express-web-server-security.md", "rationale": "Cookie-authenticated state-changing requests MUST be CSRF-protected."}, {"id": "javascript_express_web_server_security_express_inject_001", "label": "EXPRESS-INJECT-001: SQL Injection Prevention", "file_type": "rationale", "source_file": ".cline/skill